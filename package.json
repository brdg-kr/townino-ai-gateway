{
  "name": "townino-ai-gateway",
  "version": "0.1.0",
  "description": "Townino server-side OpenAI image gateway.",
  "main": "dist/src/local-server.js",
  "scripts": {
    "dev": "tsx watch src/local-server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/local-server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "npm run typecheck && npm run test"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.15",
    "openai": "^6.35.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
